# Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leksin
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# JWT (wajib; Base64, minimal 32 byte)
JWT_SECRET=replace-with-base64-encoded-key
JWT_EXPIRATION_MS=86400000