# Server
PORT=8080

# Database
# compose.yaml overrides DB_HOST with the internal Docker service name.
DB_HOST=database
DB_PORT=5432
DB_NAME=leksin
DB_USERNAME=leksin
DB_PASSWORD=change-this-local-password
DB_POOL_SIZE=5

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Email (Brevo SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM=verified-sender@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# JWT (required; Base64-encoded key with at least 32 bytes)
JWT_SECRET=replace-with-output-from-openssl-rand-base64-32
JWT_EXPIRATION_MS=86400000
